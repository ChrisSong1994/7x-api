# File path: /etc/systemd/system/7x-api.service
# sudo systemctl daemon-reload
# sudo systemctl start 7x-api
# sudo systemctl enable 7x-api
# sudo systemctl status 7x-api
[Unit]
Description=One API Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/7x-api  # 注意修改路径
ExecStart=/path/to/7x-api/7x-api --port 3000 --log-dir /path/to/7x-api/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
